# EcoSense Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Public URL of this Next.js deployment.
# Used for sitemap and Open Graph metadata.
# Omit in local development.
NEXT_PUBLIC_SITE_URL=https://ecosense.vercel.app

# URL of the FastAPI backend server.
# In local development the backend runs at http://localhost:8000.
# In production point this at your Render deployment URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase credentials (optional).
# When these are absent all API routes fall back to local seed data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

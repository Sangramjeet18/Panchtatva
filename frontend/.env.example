# EcoSense Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# URL of the FastAPI backend server (REQUIRED).
# In local development: http://127.0.0.1:8000
# In production: https://ecosense-backend.onrender.com
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Public URL of this Next.js deployment.
# Used for sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://ecosense.vercel.app
